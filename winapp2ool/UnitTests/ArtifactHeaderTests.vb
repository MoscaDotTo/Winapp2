Option Strict On

''' <summary>
''' Tests for the generators' shared artifact header (<c> ArtifactHeader </c>): its exact text
''' for a per-letter file and a folder source, <c> blob/ </c> against <c> tree/ </c> links,
''' <c> # </c> linked as <c> %23 </c>, the count format, and that it has no trailing whitespace
''' and no license. Also covers the shared splitter (<c> LetterSplitOutput </c>), which writes
''' all 27 files under that header.
''' </summary>
<TestClass()> Public Class ArtifactHeaderTests

    ''' <summary>
    ''' A per-letter file's header, exactly as the plan fixes it
    ''' </summary>
    <TestMethod()> Public Sub LetterFile_HasTheExactText()

        Dim expected = String.Join(vbCrLf,
            "; # of entries: 370",
            "; A.ini is a build artifact generated by winapp2ool's EntryBuilder. Don't edit it directly:",
            "; the next build overwrites it. In the winapp2 repository, its entries come from:",
            ";   https://github.com/MoscaDotTo/Winapp2/blob/master/Assembler/Sources/EntryBuilder/A.ini",
            "; It contains entries beginning with the letter A.",
            ";",
            "; This is one piece of winapp2.ini, not a usable winapp2.ini. The finished file, in every flavor:",
            ";   https://github.com/MoscaDotTo/Winapp2/releases/latest",
            "; To add or fix an entry, see:",
            ";   https://github.com/MoscaDotTo/Winapp2/blob/master/CONTRIBUTING.md",
            "", "")

        Dim actual = winapp2ool.ArtifactHeader.Text("A.ini", "EntryBuilder", 370, "Assembler/Sources/EntryBuilder/A.ini",
                                                    sourceIsFolder:=False, description:="It contains entries beginning with the letter A.")

        Assert.AreEqual(expected, actual)

    End Sub

    ''' <summary>
    ''' A single-file artifact links its source folder with a <c> tree/ </c> link, says the
    ''' entries come from the files in it, and has no description line
    ''' </summary>
    <TestMethod()> Public Sub FolderSource_HasTheExactText()

        Dim expected = String.Join(vbCrLf,
            "; # of entries: 1,254",
            "; browsers.ini is a build artifact generated by winapp2ool's BrowserBuilder. Don't edit it directly:",
            "; the next build overwrites it. In the winapp2 repository, its entries come from the files in:",
            ";   https://github.com/MoscaDotTo/Winapp2/tree/master/Assembler/Sources/BrowserBuilder",
            ";",
            "; This is one piece of winapp2.ini, not a usable winapp2.ini. The finished file, in every flavor:",
            ";   https://github.com/MoscaDotTo/Winapp2/releases/latest",
            "; To add or fix an entry, see:",
            ";   https://github.com/MoscaDotTo/Winapp2/blob/master/CONTRIBUTING.md",
            "", "")

        Dim actual = winapp2ool.ArtifactHeader.Text("browsers.ini", "BrowserBuilder", 1254,
                                                    winapp2ool.ArtifactHeader.BrowserBuilderSources, sourceIsFolder:=True)

        Assert.AreEqual(expected, actual)

    End Sub

    ''' <summary>
    ''' A file source gets a <c> blob/ </c> link and a folder a <c> tree/ </c> one, both on
    ''' <c> master </c>, and <c> # </c> is written as <c> %23 </c>
    ''' </summary>
    <TestMethod()> Public Sub SourceLink_BlobOrTree_AndEscapesHash()

        Assert.AreEqual("https://github.com/MoscaDotTo/Winapp2/blob/master/Assembler/Sources/UWPBuilder/AppInfo/B.ini",
                        winapp2ool.ArtifactHeader.SourceLink("Assembler/Sources/UWPBuilder/AppInfo/B.ini", False))
        Assert.AreEqual("https://github.com/MoscaDotTo/Winapp2/tree/master/Assembler/Sources/UWPBuilder",
                        winapp2ool.ArtifactHeader.SourceLink(winapp2ool.ArtifactHeader.UWPBuilderSources, True))
        Assert.AreEqual("https://github.com/MoscaDotTo/Winapp2/blob/master/Assembler/Sources/EntryBuilder/%23.ini",
                        winapp2ool.ArtifactHeader.SourceLink("Assembler/Sources/EntryBuilder/#.ini", False))

    End Sub

    ''' <summary>
    ''' An empty file's count reads <c> 0 </c>, where the old <c> #,### </c> format printed
    ''' nothing, and a count of 1 or more prints as it always did
    ''' </summary>
    <TestMethod()> Public Sub EntryCount_PrintsZeroAndThousands()

        Assert.AreEqual("; # of entries: 0", winapp2ool.ArtifactHeader.EntryCountLine(0))
        Assert.AreEqual("; # of entries: 7", winapp2ool.ArtifactHeader.EntryCountLine(7))
        Assert.AreEqual("; # of entries: 3,812", winapp2ool.ArtifactHeader.EntryCountLine(3812))

    End Sub

    ''' <summary>
    ''' No header line ends in whitespace, and no header carries a license line
    ''' </summary>
    <TestMethod()> Public Sub Header_HasNoTrailingWhitespaceOrLicense()

        Dim headers = {
            winapp2ool.ArtifactHeader.Text("#.ini", "UWPBuilder", 0, "Assembler/Sources/UWPBuilder/AppInfo/#.ini", False, "It contains entries beginning with symbols or numbers."),
            winapp2ool.ArtifactHeader.Text("uwp.ini", "UWPBuilder", 192, winapp2ool.ArtifactHeader.UWPBuilderSources, True)
        }

        For Each header In headers

            For Each line In header.Split({vbCrLf}, StringSplitOptions.None)

                Assert.AreEqual(line.TrimEnd(), line, $"Trailing whitespace in: '{line}'")
                Assert.IsFalse(line.IndexOf("licen", StringComparison.OrdinalIgnoreCase) >= 0, $"License line: '{line}'")

            Next

        Next

    End Sub

    ' ----- Shared splitter -----

    ''' <summary>
    ''' Builds an <c> iniFile </c> holding one minimal section per name
    ''' </summary>
    '''
    ''' <param name="names">The section names</param>
    Private Shared Function FileWith(ParamArray names As String()) As winapp2ool.iniFile

        Dim file = winapp2ool.iniFile.Empty("", "out.ini")

        For Each name In names

            Dim section As New winapp2ool.iniSection(name, 0)
            section.AddKey(New winapp2ool.iniKey("LangSecRef=3021", 0))
            file.AddSection(section)

        Next

        Return file

    End Function

    ''' <summary>
    ''' The splitter buckets by entry name, writes all 27 files including the empty ones, and
    ''' each file's header links the given source folder's file of the same letter
    ''' </summary>
    <TestMethod()> Public Sub Splitter_WritesAll27FilesBucketedByName()

        Dim dir = IO.Path.Combine(IO.Path.GetTempPath(), $"winapp2ool-split-{Guid.NewGuid():N}")

        Try

            Dim menu As New winapp2ool.MenuSection
            winapp2ool.LetterSplitOutput.WriteSplitOutput(FileWith("Alpha *", "apple *", "3D Thing *", "Zed *"), dir,
                                                          "UWPBuilder", "Some/Source", menu)

            Dim files = IO.Directory.GetFiles(dir).Select(Function(f) IO.Path.GetFileName(f)).OrderBy(Function(f) f, StringComparer.Ordinal).ToList()
            Assert.AreEqual(27, files.Count)
            CollectionAssert.AreEqual(winapp2ool.LetterSplitOutput.Letters.Select(Function(l) l & ".ini").ToList(), files)

            Dim a = IO.File.ReadAllText(IO.Path.Combine(dir, "A.ini"))
            StringAssert.StartsWith(a, "; # of entries: 2" & vbCrLf & "; A.ini is a build artifact generated by winapp2ool's UWPBuilder.")
            StringAssert.Contains(a, ";   https://github.com/MoscaDotTo/Winapp2/blob/master/Some/Source/A.ini" & vbCrLf)
            StringAssert.Contains(a, "[Alpha *]")
            StringAssert.Contains(a, "[apple *]")

            Dim hash = IO.File.ReadAllText(IO.Path.Combine(dir, "#.ini"))
            StringAssert.Contains(hash, "/blob/master/Some/Source/%23.ini" & vbCrLf)
            StringAssert.Contains(hash, "; It contains entries beginning with symbols or numbers." & vbCrLf)
            StringAssert.Contains(hash, "[3D Thing *]")

            Dim b = IO.File.ReadAllText(IO.Path.Combine(dir, "B.ini"))
            StringAssert.StartsWith(b, "; # of entries: 0" & vbCrLf)
            Assert.IsFalse(b.Contains("["), "An empty letter's file holds no section")

        Finally

            If IO.Directory.Exists(dir) Then IO.Directory.Delete(dir, recursive:=True)

        End Try

    End Sub

    ''' <summary>
    ''' A letter that empties is overwritten with a header-only file, never left stale
    ''' </summary>
    <TestMethod()> Public Sub Splitter_OverwritesALetterThatEmptied()

        Dim dir = IO.Path.Combine(IO.Path.GetTempPath(), $"winapp2ool-split-{Guid.NewGuid():N}")

        Try

            Dim menu As New winapp2ool.MenuSection
            winapp2ool.LetterSplitOutput.WriteSplitOutput(FileWith("Beta *"), dir, "EntryBuilder", "Src", menu)
            StringAssert.Contains(IO.File.ReadAllText(IO.Path.Combine(dir, "B.ini")), "[Beta *]")

            winapp2ool.LetterSplitOutput.WriteSplitOutput(FileWith("Gamma *"), dir, "EntryBuilder", "Src", menu)
            Assert.IsFalse(IO.File.ReadAllText(IO.Path.Combine(dir, "B.ini")).Contains("[Beta *]"))

        Finally

            If IO.Directory.Exists(dir) Then IO.Directory.Delete(dir, recursive:=True)

        End Try

    End Sub

End Class
