# Visual Studio / MSBuild scratch
.vs/
obj/
packages/
TestResults/

# Signing material
*.pfx
*.p8

# Build output. Deployed clients download winapp2ool.exe and its .sig from these
# exact paths, so we track only those
winapp2ool/bin/Debug/*
!winapp2ool/bin/Debug/winapp2ool.exe
winapp2ool/bin/Release/*
!winapp2ool/bin/Release/winapp2ool.exe
!winapp2ool/bin/Release/winapp2ool.exe.sig

# Test binaries
winapp2ool/UnitTests/bin/

# Local tooling config
*.user
.claude/
.editorconfig

# Local-only working docs
CLAUDE.md
GLOBAL_STATE.md
XMLDOC.md
OBJECT_MODEL_DESIGN.md

# VB designer codegen
winapp2ool/My Project/Settings.Designer.vb
winapp2ool/My Project/Resources.Designer.vb
